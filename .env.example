# ==============================================================================
# CycleAware — Women's Hormonal Health Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Application Basics
APP_ENV=development
APP_NAME=CycleAware
APP_VERSION=1.0.0
APP_URL=http://localhost:5173
API_V1_PREFIX=/api/v1

# Security & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_secret_key_change_in_production_min_32_bytes_random_value
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_bytes_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Default: Local SQLite for rapid zero-dependency dev/test. In production, use PostgreSQL.
DATABASE_URL=sqlite:///./cycleaware.db
# DATABASE_URL=postgresql+psycopg://cycleaware_user:cycleaware_pass@localhost:5432/cycleaware_db

# Redis (Optional in local dev, recommended in production for rate limiting/caching)
REDIS_URL=redis://localhost:6379/0

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Email Service (Mock in development)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=notifications@cycleaware.local

# File Storage
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./private_uploads
MAX_FILE_SIZE_MB=10

# Product & Safety Flags
DEMO_MODE=true
EXPERIMENTAL_ML_ENABLED=true
CLINICAL_ML_ENABLED=false

# Clinical Terminology Preference (PCOS | PCOD | PMOS)
PRIMARY_TERMINOLOGY=PMOS

# Sentry Monitoring (Optional)
SENTRY_DSN=

